# ── 第1層: LiteLLM Proxy ───────────────────────────────
# エージェントが接続する OpenAI 互換エンドポイント
OPENAI_BASE_URL=http://localhost:4000
# LiteLLM Proxy 自体の master key (エージェント → Proxy の認証)
LITELLM_MASTER_KEY=sk-local-poc

# 読み込む設定ファイル。異常系では config.fault.yaml に切り替える
LITELLM_CONFIG_FILE=config.yaml

# Amazon Bedrock のクレデンシャル
# リージョンとモデル ID は litellm/config.yaml に直接書く（秘密情報ではないため）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SSO / AssumeRole の一時クレデンシャルを使う場合のみ
AWS_SESSION_TOKEN=

# ── 障害注入 (異常系のみ) ───────────────────────────────
# rate_limit (429) | server_error (500) | timeout | success
FAULT_MODE=server_error
# FAULT_MODE=timeout のときのスリープ秒数。LiteLLM の timeout(30) より大きくする
FAULT_DELAY_SECONDS=45

# ── 第3層: OPA (Phase 3 以降) ──────────────────────────
OPA_URL=http://localhost:8181

# ── エスカレーション層: Slack (Phase 4 以降) ────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
