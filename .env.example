# ── 第1層: LiteLLM Proxy ───────────────────────────────
# エージェントが接続する OpenAI 互換エンドポイント
OPENAI_BASE_URL=http://localhost:4000
# LiteLLM Proxy 自体の master key (エージェント → Proxy の認証)
LITELLM_MASTER_KEY=sk-local-poc

# 読み込む設定ファイル。異常系では config.fault.yaml に切り替える
LITELLM_CONFIG_FILE=config.yaml

# ── 障害注入 (異常系のみ) ───────────────────────────────
# 第1層: rate_limit (429) | server_error (500) | timeout | success
# 第2層: malformed (HTTP 200 のまま content だけを壊す)
FAULT_MODE=server_error
# FAULT_MODE=timeout のときのスリープ秒数。LiteLLM の timeout(30) より大きくする
FAULT_DELAY_SECONDS=45
# FAULT_MODE=malformed のときに content へ詰める fixture 名 (tests/fixtures/ の拡張子なし名)。
# 予約名 null_content は content: null を返す
FAULT_FIXTURE=v01_prose

# ── 第3層: OPA ─────────────────────────────────────────
# 問い合わせ先は decision 文書のフルパス。allow と violated_rules を 1 回で受け取る。
# パスを間違えると OPA は 200 と {} を返す（undefined）。エージェントはこれを
# allow: false ではなく「評価不能」として Fail-Closed する (D-017)
OPA_URL=http://localhost:8181/v1/data/sre/agent/decision
# 評価のタイムアウト。初期値は 3.0 で、Phase 3 の L-01 で実測して確定する
# （timeout はワークロードごとに実測して決める。Phase 2 の教訓）
OPA_TIMEOUT_SECONDS=3.0

# 読み込ませるポリシーディレクトリ。異常系でのみ変更する
#   X-04 (undefined)        ./mocks/opa_faults/no_policy
#   X-05 (decision の逸脱)  ./mocks/opa_faults/allow_as_string | contradictory | unknown_key
OPA_POLICY_DIR=./opa

# ── エスカレーション層: Slack (Phase 4) ─────────────────
# 未設定なら送出しない。これは障害ではなく構成であり、終了コードは変わらない
# (Phase 1〜3 の経路をそのまま再現できる必要があるため)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# 送出先。チャンネル ID (C...) のほか、**ユーザ ID (U...) を書くと Bot との DM** に送る。
# 検証用チャンネルを作らずに試せる。DM に送るには im:write スコープが要る
SLACK_CHANNEL_ID=

# 承認できるユーザ (Slack の user.id をカンマ区切り)。
# **未設定なら誰も承認できない。** 未設定が「全員許可」になるほうが事故として重いため、
# 認可も Fail-Closed に倒す。操作の種別や環境による出し分けはしない (D-021)
SLACK_APPROVER_USER_IDS=

# 承認待ちステートストア (SQLite)。運用ステートと監査記録が入る
SLACK_STORE_PATH=var/handoff.sqlite3
# 承認期限。満了の判定は slack/expire.py が走査して行う
SLACK_APPROVAL_TTL_SECONDS=900
# TOCTOU の閾値。**提案 (created_at) から**実行までの許容時間であり、承認からではない
SLACK_TOCTOU_SECONDS=300
# Slack Web API のタイムアウト。初期値 10.0 は Phase 4 の L-01 で実測して確定する
SLACK_TIMEOUT_SECONDS=10.0
# Interactivity を受ける常駐プロセスのポート (ngrok の転送先)
SLACK_HANDLER_PORT=3000

# 送出の異常系 (E 系) でのみ変更する。mocks/fault_injector.py に向けて注入する。
# 例: SLACK_API_BASE_URL=http://localhost:8080/api/
SLACK_API_BASE_URL=

# ── Amazon Bedrock のクレデンシャル ─────────────────────
# リージョンとモデル ID は litellm/config.yaml に直接書く（秘密情報ではないため）。
#
# ここを最後に置いているのは、SSO の一時クレデンシャルを末尾に追記して更新する運用のため。
# dotenv も docker compose も「後に書かれた値が勝つ」ので、失効したら再ログインして
# 下記コマンドの出力を末尾に足すだけでよい（古い行を消す必要はない）。
#
#   aws sso login --profile <PROFILE>
#   aws configure export-credentials --profile <PROFILE> --format env-no-export >> .env
#
# 一時クレデンシャルは数時間で失効する。LiteLLM コンテナは起動時に環境変数を焼き込むため、
# 更新後は docker compose up -d でコンテナを作り直さないと反映されない。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SSO / AssumeRole の一時クレデンシャルを使う場合のみ
AWS_SESSION_TOKEN=
